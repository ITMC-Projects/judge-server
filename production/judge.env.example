# Registered judge name. Must match the name in OJ Admin > Judges.
DMOJ_JUDGE_NAME=judge-prod-01
# Generated by prod-init. Register this exact key in OJ; never reuse the OTS token.
DMOJ_JUDGE_KEY=
# Same-VPS Docker network and bridge service/container DNS.
OJ_NETWORK=itmc-oj-prod_db
OJ_BRIDGE_HOST=itmc-oj-prod-bridged
OJ_BRIDGE_PORT=9999
# prod-init fills the absolute path to the sibling OJ production problem directory.
OJ_PROBLEMS_DIR=
